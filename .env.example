# Copy this file to .env and change the values.
SECRET_KEY=change-this-to-a-long-random-string
# SQLite (default, nothing to install):
# DATABASE_URL=sqlite:///instance/talenthub.db
# MySQL (XAMPP / MySQL server) - install PyMySQL first:  pip install PyMySQL
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/jayhind_talenthub?charset=utf8mb4
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=1
